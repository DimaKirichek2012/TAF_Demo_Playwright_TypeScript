{
  "name": "taf-demo-playwright-typescript",
  "version": "1.0.0",
  "description": "Layered Playwright + TypeScript test automation framework: UI (Page Object Model) and API tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "typescript", "test-automation", "page-object-model", "api-testing"],
  "author": "Dmytro Kyrychek",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
